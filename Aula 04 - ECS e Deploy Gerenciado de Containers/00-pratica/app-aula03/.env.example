# Copie este arquivo para ".env" (que NAO vai para o Git) para rodar
# "docker compose up" apontando para um banco especifico.
#
# Em producao (EC2), este arquivo e gerado automaticamente pelo script de
# user_data, com o endpoint real do RDS — voce nunca precisa criar esse
# .env manualmente la (ver modulo 05).
DB_HOST=SEU_ENDPOINT_RDS_AQUI
DB_PORT=3306
DB_NAME=app_aula03
DB_USER=admin
DB_PASSWORD=SUA_SENHA_AQUI
